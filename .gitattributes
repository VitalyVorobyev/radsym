# Check text files out with LF on every platform, overriding Git for Windows'
# default `core.autocrlf=true`. Generated files (`schemas/*.json` from
# `cargo xtask emit-schemas`) are checked byte-for-byte by CI and written with
# LF by the generator, so a CRLF checkout would make them look like drift.
# The LFS rule below still wins for its pattern (last match wins).
* text=auto eol=lf

*.png filter=lfs diff=lfs merge=lfs -text
